# เลือกกล้อง (ดูด้วย v4l2-ctl --list-devices ว่าเป็น /dev/video0 หรือ 1)
export CAM_SRC=0

# เปิด UI + เพิ่มความทนแสง
export SHOW=1 DRAW=1
export CLAHE=1 CLAHE_CLIP=2.0 CLAHE_GRID=8
export GAMMA=1.15

# ใช้เกณฑ์ใกล้ 1.5 m + ต้องอยู่ต่อเนื่อง 1.5s
export NEAR_M=1.5 MIN_DWELL_MS=1500

# หลังปลุกไปแล้วพัก 8s กันเด้ง
export COOLDOWN_S=8

# ล็อก AE ถ้ากล้องชอบไล่แสง (ลองดู ถ้ามืดเกินค่อยปิด LOCK_AE)
export LOCK_AE=1 EXPOSURE=-6 GAIN=0

# โลโก้ (ถ้ามี)
export LOGO_PATH=./CoE/CoE-Eng.png LOGO_MAXW=160 LOGO_ANCHOR=top-right

# ชื่อแอป/แบนเนอร์
export APP_TITLE="Smart Voting Machine"
export BANNER_TXT="Please stand inside the frame to wake the screen"